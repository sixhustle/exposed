[mysqld]
server-id                = 2
log-bin                  = mysql-bin
relay-log                = relay-bin
gtid-mode                = ON
enforce-gtid-consistency = ON
character-set-server     = utf8mb4
collation-server         = utf8mb4_0900_ai_ci
# read_only / super_read_only 는 02-start-replica.sql 에서 SET PERSIST 로 켠다.
# 여기서 켜면 엔트리포인트의 초기화(사용자 생성)까지 막힌다.
